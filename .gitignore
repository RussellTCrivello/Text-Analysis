node_modules/
dist/
.cache/
.env*
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# SSR render smoke-test output (generated by `npm run smoke`)
.smoke/

# DOM smoke harness build output
.domcheck/

# electron-builder output
release/

# `build/` holds committed installer assets (icon.ico / icon.png) — it is the
# electron-builder `buildResources` dir, not a compilation output. Keep the
# icons tracked and ignore anything else that lands there.
build/*
!build/icon.ico
!build/icon.png
