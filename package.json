{
  "name": "text-analysis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/ts-resolve-hooks.mjs --test \"src/core/**/*.test.ts\"",
    "check": "npm run typecheck && npm run test && npm run smoke",
    "smoke": "vite build --ssr scripts/smoke.tsx --outDir .smoke --logLevel error && node .smoke/smoke.js",
    "smoke:dom": "vite build --ssr scripts/dom-check.tsx --outDir .domcheck --logLevel error && node .domcheck/dom-check.js",
    "electron:dev": "node scripts/electron-dev.mjs",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win --x64",
    "dist:dir": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "jsdom": "^26.1.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "productName": "Text Analysis",
  "description": "Local-first workspace for structured text analysis",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.russellcrivello.textanalysis",
    "productName": "Text Analysis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Text Analysis"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": null
  }
}
